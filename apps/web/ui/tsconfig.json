{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../../..",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The ui tree predates typechecking and was never held to the repo's
    // strictest flags; `strict` itself stays on. Tightening these two is
    // follow-up work, not a research-feature concern.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}
